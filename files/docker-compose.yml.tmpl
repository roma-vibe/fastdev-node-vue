# Uses the project's .env: COMPOSE_PROJECT_NAME names the stack, DOCKER_DATA selects where the
# SQLite database lives ("data" = named volume, "./data" = the project folder), the other keys
# configure the app.
{%- if choices.docker == "full" %}
# Everything runs in containers: `docker compose up dev` for development with hot reload,
# `docker compose run --rm dev npm <script>` for any npm command, `docker compose up --build app`
# for the production container.
{%- endif %}
services:
  app:
    build:
      context: .
      args:
        APP_NAME: ${APP_NAME:?Set APP_NAME in .env}
    env_file: .env
    environment:
      NODE_ENV: production
      # Listen on all interfaces inside the container.
      APP_HOST: 0.0.0.0
    ports:
      # Published on the host's loopback only: other machines on the network cannot reach it.
      - '127.0.0.1:${APP_PORT:-3000}:${APP_PORT:-3000}'
    volumes:
      # SQLite files (DB_PATH=data/...): named volume or the project's data/ folder.
      - ${DOCKER_DATA:-data}:/app/data
    healthcheck:
      test:
        [
          'CMD',
          'node',
          '-e',
          "fetch('http://127.0.0.1:' + (process.env.APP_PORT || 3000) + '/api/health').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))",
        ]
      interval: 30s
      timeout: 5s
      start_period: 10s
      retries: 3
    restart: unless-stopped
{%- if choices.docker == "full" %}

  dev:
    profiles: ['dev']
    build:
      context: .
      target: dev
    # Like on the host, the app reads the mounted .env itself (no env_file, whose values would
    # win over later edits of .env), and `npm run dev` sets NODE_ENV for the API only: a global
    # NODE_ENV=development would make `npm run build` bundle the development build of Vue.
    environment:
      # Listen on all interfaces inside the container so the published ports work.
      APP_HOST: 0.0.0.0
      WEB_HOST: 0.0.0.0
      # secbase and walls are installed on the host, not in this image: `npm run check` here skips
      # their steps with a notice. Run `npm run walls` and `npm run security` on the host too.
      SECBASE_OPTIONAL: '1'
      WALLS_OPTIONAL: '1'
    ports:
      # Published on the host's loopback only: other machines on the network cannot reach them.
      - '127.0.0.1:${APP_PORT:-3000}:${APP_PORT:-3000}'
      - '127.0.0.1:${WEB_PORT:-5173}:${WEB_PORT:-5173}'
    volumes:
      # Sources from the project folder; dependencies stay in volumes (Linux builds of native packages).
      - .:/app
      - node_modules:/app/node_modules
      - server_node_modules:/app/server/node_modules
      - web_node_modules:/app/web/node_modules
      - ${DOCKER_DATA:-data}:/app/data
{%- endif %}

volumes:
  data:
{%- if choices.docker == "full" %}
  node_modules:
  server_node_modules:
  web_node_modules:
{%- endif %}
