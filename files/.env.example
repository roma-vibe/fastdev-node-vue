# Application name and slug. APP_NAME is the single source of the app name (UI, API, page title).
APP_NAME="My App"
APP_SLUG=my-app

# API server (npm start, npm run dev). Use 0.0.0.0 to accept connections from other hosts.
APP_HOST=localhost
APP_PORT=3000

# Vite dev server (npm run dev); proxies /api to APP_PORT.
WEB_PORT=5173

# SQLite database file, relative to the project root.
DB_PATH=data/my-app.sqlite

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
