# Application name and slug. APP_NAME is the single source of the app name (UI, API, page title).
APP_NAME="My App"
APP_SLUG=my-app

# API server (npm start, npm run dev). Loopback only; Docker Compose sets 0.0.0.0 inside the
# container. Do not set 0.0.0.0 here: publish the app through a tunnel or a reverse proxy.
APP_HOST=127.0.0.1
APP_PORT=3000

# Public URL of the app once it is published (e.g. https://app.example.com). An https URL turns on
# Strict-Transport-Security, and its host name is accepted in the Host header. Empty: not published.
PUBLIC_URL=

# More host names the app answers to, comma-separated (e.g. app.example.com,notes.internal), any
# port. localhost, 127.0.0.1, [::1] and the PUBLIC_URL host are always allowed; any other Host
# header gets 421 (protection against DNS rebinding). Add the tunnel or LAN name here when you
# publish the app under a name that is not PUBLIC_URL.
ALLOWED_HOSTS=

# Largest accepted request body in bytes (1 MiB); larger requests get 413.
MAX_BODY_BYTES=1048576

# Vite dev server (npm run dev); proxies /api to APP_PORT.
WEB_PORT=5173

# SQLite database file, relative to the project root.
DB_PATH=data/my-app.sqlite

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
